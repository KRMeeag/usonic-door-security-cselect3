#pragma once
// ---------------------------------------------------------------------------
// Template. Copy to secrets.h and fill in real values.
//   cp include/secrets.h.example include/secrets.h
//
// secrets.h is gitignored — it holds credentials and must never be committed.
// These MUST be visible before <BlynkSimpleEsp32.h> is included, which is why
// secrets.h is included first in main.cpp. Do NOT also define them in main.cpp
// — a second #define silently overrides this file.
// ---------------------------------------------------------------------------

#define BLYNK_TEMPLATE_ID   "TMPLxxxxxxxx"
#define BLYNK_TEMPLATE_NAME "Door Intrusion Detection"
#define BLYNK_AUTH_TOKEN    "PASTE-DEVICE-AUTH-TOKEN"

// 2.4 GHz ONLY — the ESP32-S3 has no 5 GHz radio.
#define WIFI_SSID  "your-2G4-ssid"
#define WIFI_PASS  "your-wifi-password"
